"""Monocular-depth perch candidate detector for Raspberry Pi 5.

Detection: MiDaS v2.1 Small ONNX (relative inverse depth) + geometry/profile.
Measurement: optional, independently calibrated stereo depth at trigger only.
IMPORTANT: no autonomous landing decision is produced by this prototype.

T=burst/verify, D=depth window, R=reset, S=save, Q/ESC=quit.
No YOLO/ultralytics or command line arguments required.
"""
from __future__ import annotations

import math
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Optional

import cv2
import numpy as np

