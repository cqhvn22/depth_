# Depth-based segmentation. Outputs are relative (NOT meters).
TOPHAT_VERTICAL_PX = 43   # at ANALYSIS_WIDTH; suppress thick regions
RELIEF_THRESHOLD = 0.058 # minimum local inverse-depth relief, normalized [0,1]
MIN_BAR_LENGTH_PX = 38
MIN_BAR_THICK_PX = 3.0
MAX_BAR_THICK_PX = 55.0
MIN_ASPECT_RATIO = 4.0
MAX_TILT_DEG = 29.9       # strictly < 30 degrees
MIN_CYLINDER_PROFILE = 0.008  # center of cross-section nearer than both sides
