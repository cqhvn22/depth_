CALIB_UNIT = "mm"       # mm | cm | m
MIN_VALID_STEREO_PX = 20
MIN_STEREO_VALID_FRACTION = 0.10
N_BURST = 7
MIN_BURST_PRESENCE = 0.60

MIN_LENGTH_M, MAX_LENGTH_M = 0.10, 2.00
MIN_WIDTH_M, MAX_WIDTH_M = 0.02, 0.20
MIN_DIST_M, MAX_DIST_M = 0.20, 5.00

SHOW_DEPTH_ON_START = True
