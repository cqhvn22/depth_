# MiDaS v2.1 Small ONNX at 256x256. The upstream MiDaS transform uses RGB.
# Some third-party exports document BGR: test the model/export if depth is odd.
MODEL_INPUT_SIZE = 256
MODEL_INPUT_COLOR = "RGB"  # RGB | BGR
MODEL_BACKEND = "auto"  # auto | onnxruntime | opencv
CPU_THREADS = 3
LIVE_INFER_EVERY = 2  # only infer on every Nth live frame; burst always infers
